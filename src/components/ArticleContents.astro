---
interface Props { items: { id: string; label: string }[]; }
const { items } = Astro.props;
---
{items.length > 1 && <nav class="article-contents" aria-label="In this article">
  <h2>In this article</h2>
  <ul>{items.map(item => <li><a href={`#${encodeURIComponent(item.id)}`}>{item.label}</a></li>)}</ul>
</nav>}
<style>
  .article-contents { align-self: start; position: sticky; top: 32px; padding-top: 12px; }
  h2 { font-size: 16px; line-height: 1.5; letter-spacing: normal; margin-bottom: 16px; }
  ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--border); }
  a { display: block; padding: 10px 16px; color: var(--secondary); font-size: 14px; line-height: 1.5; }
  a:hover { color: var(--text); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 900px) {
    .article-contents { position: static; padding-block: 0 28px; border-bottom: 1px solid var(--border); }
    ul { display: flex; flex-wrap: wrap; gap: 4px 20px; border: 0; }
    a { padding: 8px 0; min-height: 44px; }
  }
</style>
